<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
<div class="col-lg-10 mx-auto">

<h3 class="mb-4">Edit your Listing</h3>

<form 
action="/listings/<%= listing._id %>?_method=PUT" 
method="POST"
enctype="multipart/form-data"
>

<input type="hidden" name="_method" value="PUT">

<!-- Title -->
<div class="mb-3">
<label class="form-label fw-bold">Title</label>
<input
type="text"
name="listing[title]"
value="<%= listing.title %>"
class="form-control border border-dark border-2 rounded-3"
required
/>
</div>

<!-- Description -->
<div class="mb-3">
<label class="form-label fw-bold">Description</label>
<textarea
name="listing[description]"
class="form-control border border-dark border-2 rounded-3"
rows="2"
required
><%= listing.description %></textarea>
</div>

<!-- CURRENT IMAGE -->
<div class="mb-3">

<label class="form-label fw-bold">Current Image</label>

<br>

<img src = "<%= originalImageUrl %>" alt="Current Listing Image"


style="width:200px;height:150px;object-fit:cover;border-radius:8px;"
>

</div>

<!-- UPLOAD NEW IMAGE -->

<div class="mb-3">

<label class="form-label fw-bold">Upload New Image</label>

<input
type="file"
name="listing[image]"
class="form-control border border-dark border-2 rounded-3"
/>

</div>

<!-- Price + Country -->

<div class="row mb-3">

<div class="col-md-6">
<label class="form-label fw-bold">Price</label>
<input
type="number"
name="listing[price]"
value="<%= listing.price %>"
class="form-control border border-dark border-2 rounded-3"
required
/>
</div>

<div class="col-md-6">
<label class="form-label fw-bold">Country</label>
<input
type="text"
name="listing[country]"
value="<%= listing.country %>"
class="form-control border border-dark border-2 rounded-3"
/>
</div>

</div>

<!-- Location -->

<div class="mb-4">

<label class="form-label fw-bold">Location</label>

<input
type="text"
name="listing[location]"
value="<%= listing.location %>"
class="form-control border border-dark border-2 rounded-3"
/>

</div>

<button class="btn btn-danger">Edit</button>

</form>

</div>
</div>