
<% layout("/layouts/boilerplate") %>

<!-- //This page lists all listings. -->
<div id="filters">

<a href="/listings/filter/Trending" class="filter">
  <i class="fa-solid fa-fire"></i>
  <p>Trending</p>
</a>

<a href="/listings/filter/Rooms" class="filter">
  <i class="fa-solid fa-bed"></i>
  <p>Rooms</p>
</a>

<a href="/listings/filter/Iconic cities" class="filter">
  <i class="fa-solid fa-mountain-city"></i>
  <p>Iconic cities</p>
</a>

<a href="/listings/filter/Mountains" class="filter">
  <i class="fa-solid fa-mountain"></i>
  <p>Mountains</p>
</a>

<a href="/listings/filter/Castles" class="filter">
  <i class="fa-solid fa-dungeon"></i>
  <p>Castles</p>
</a>

<a href="/listings/filter/Amazing pools" class="filter">
  <i class="fa-solid fa-swimmer"></i>
  <p>Amazing pools</p>
</a>

<a href="/listings/filter/Camping" class="filter">
  <i class="fa-solid fa-campground"></i>
  <p>Camping</p>
</a>

<a href="/listings/filter/Farms" class="filter">
  <i class="fa-solid fa-tractor"></i>
  <p>Farms</p>
</a>

<a href="/listings/filter/Arctic" class="filter">
  <i class="fa-solid fa-snowflake"></i>
  <p>Arctic</p>
</a>


<div class="tax-toggle">

  <div class="form-check form-switch">

    <label class="form-check-label" for="switchCheckDefault">
      Display total after taxes
    </label>

    <input 
      class="form-check-input"
      type="checkbox"
      role="switch"
      id="switchCheckDefault"
    >

  </div>

</div>

</div>


<!-- LISTINGS -->

<div class="row">

<% for(let listing of allListings){ %>

<div class="col-lg-4 col-md-6 col-sm-16 mb-7">

<a href="/listings/<%= listing._id %>" style="text-decoration:none; color:inherit;">

<div class="card h-100">

  <img
  src="<%= listing.image && listing.image.url ? listing.image.url : '' %>"
  class="card-img-top"
  alt="listing_image"
  style="height:320px; width:100%; object-fit:cover;"
/>
<div class="card-body">
<h5 class="card-title">
<b><%= listing.title %></b>
</h5>

<p class="card-text">
₹ <%= listing.price != null
? Number(listing.price).toLocaleString("en-IN")
: "Price not available" %> / night
<i class="tax-info"> +18% GST</i>
</p>

<p>
<%= listing.location %>, <%= listing.country %>
</p>

</div>

</div>

</a>

</div>

<% } %>

</div>


<script>

let taxSwitch = document.getElementById("switchCheckDefault");

taxSwitch.addEventListener("change", () => {

  let taxInfo = document.querySelectorAll(".tax-info");

  for(let info of taxInfo){
    if(taxSwitch.checked){
      info.style.display = "inline";
    }else{
      info.style.display = "none";
    }

  }

});

</script>



